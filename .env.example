# Generic OpenAI-compatible LLM configuration.
# Copy this file to .env and fill in your values. The .env file is gitignored —
# your real key never enters source control.
# The CLI and web UI always read .env first, from any directory.
#
# Works with ANY OpenAI-compatible endpoint: OpenAI, DeepSeek, MiMo, Groq,
# Together, vLLM, LM Studio, Ollama (http://localhost:11434/v1), etc.
# Just point OPENAI_BASE_URL at the server and set the model it serves.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional: reasoning effort for reasoning models (low | medium | high)
# OPENAI_REASONING=

# Optional: retry with this model if the primary model call fails
# OPENAI_FALLBACK_MODEL=

# Optional: only needed for --share-pack / recipe imports via GitHub Gist
# GITHUB_TOKEN=
