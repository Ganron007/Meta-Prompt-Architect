# Pre-configured LLM for the Architect.
# Copy this file to .env and fill in your key. The .env file is gitignored —
# your real key never enters source control.
# The CLI and web UI always read .env first, from any directory.

# Pick the ONE provider you want the Architect to use by default:
#   openai | anthropic | deepseek | ollama | openai-compatible
ARCHITECT_PROVIDER=openai
ARCHITECT_MODEL=gpt-4o-mini

# Fill in the matching key:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Only needed for a custom/openai-compatible endpoint or remote Ollama:
# ARCHITECT_API_BASE=
# OLLAMA_BASE_URL=http://localhost:11434
