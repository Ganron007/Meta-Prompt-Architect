{
  "name": "meta-prompt-architect",
  "version": "2.0.0",
  "description": "A prompt generator and exporter for Cursor, OpenCode, VS Code, and other AI agents.",
  "main": "src/generator.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ganro/Meta-Prompt-Architect.git"
  },
  "homepage": "https://github.com/Ganro/Meta-Prompt-Architect#readme",
  "bin": {
    "prompt-architect": "./bin/prompt-architect"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "test": "node tests/test.js && node tests/ui.test.js",
    "build": "pkg . --out-path dist"
  },
  "keywords": [
    "prompt-engineering",
    "meta-prompt",
    "cursor",
    "opencode",
    "ai-agents"
  ],
  "author": "",
  "license": "MIT",
  "pkg": {
    "scripts": "src/cli.js",
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ]
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "happy-dom": "^20.11.2",
    "pkg": "^5.8.1"
  }
}
